RewriteEngine On

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# non-www → www
RewriteCond %{HTTP_HOST} !^www\.
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Long cache for Next.js content-hashed static assets
RewriteRule ^_next/static/ - [E=LONG_CACHE:1,NC]

<IfModule mod_headers.c>
  # 1 year cache for /_next/static/ (filenames contain content hash)
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  # HSTS — force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control what's sent in Referer header
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict unnecessary browser features
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
